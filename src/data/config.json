  "digilocker_and_ekyc": {
    "enabled": true,
    "service": "DigiLocker & UIDAI Aadhaar Paperless e-KYC",
    "benefits": [
      "Contactless paperless verification without visiting RTO for document submission",
      "Instant face authentication / Aadhaar OTP verification on Sarathi Parivahan portal",
      "Zero physical document upload required when pulled directly from DigiLocker"
