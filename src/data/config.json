      "code": "MCWOG",
      "name": "Motorcycle Without Gear",
      "category": "Two-Wheeler (Moped / Gearless)",
      "min_age": 16,
      "requires_parental_consent": true,
      "fee": 150,
      "description": "Two-wheelers up to 50cc engine capacity, mopeds, and lightweight gearless electric scooters."
    },
    {
      "code": "MCWG",
      "name": "Motorcycle With Gear",
      "category": "Two-Wheeler (All cc)",
      "min_age": 18,
      "requires_parental_consent": false,
      "fee": 150,
      "description": "Standard geared motorcycles, motorbikes, and scooters with engine capacity exceeding 50cc."
    },
    {
      "code": "LMV",
      "name": "Light Motor Vehicle",
      "category": "Four-Wheeler (Non-Transport)",
      "min_age": 18,
      "requires_parental_consent": false,
      "fee": 200,
      "description": "Personal passenger cars, hatchbacks, sedans, SUVs, and private light utility motor vehicles."
    },
    {
      "code": "TRANS",
      "name": "Commercial & Transport Vehicles",
      "category": "Commercial / Transport",
      "min_age": 20,
      "requires_parental_consent": false,
      "fee": 300,
      "requires_prior_lmv_years": 1,
      "description": "Taxis, delivery vans, auto-rickshaws, and commercial transport vehicles carrying passengers or goods."
    }
