      "age_proof": [
        "10th Class Marksheet / Passing Certificate (CBSE/ICSE/State Board via DigiLocker)",
        "Birth Certificate issued by Municipal Corporation (DigiLocker verified)",
        "Indian Passport"
      ],
      "medical_fitness": [
        "Form 1: Physical Fitness Self-Declaration (Non-Transport under 40 years)",
        "Form 1A: Medical Certificate signed by Registered Medical Practitioner (Age 40+ or Transport)"
      ]
    }
  },
