      "icon": "CalendarClock"
    },
    {
      "stage_index": 3,
      "key": "approved",
      "title": "Learner's Licence Approval",
      "description": "Computer test cleared. Digital Form 3 Learner's Licence generated and ready to download.",
      "icon": "Award"
    }
  ],
  "mock_test_settings": {
    "total_questions": 15,
    "pass_marks": 9,
    "pass_percentage": 60,
    "time_limit_minutes": 15,
    "time_per_question_seconds": 60,
    "categories": [
      "Road Signs",
      "Traffic Rules",
      "Safety"
    ]
  },
  "document_requirements": {
    "age_proof": [
      "10th Standard Marksheet / Passing Certificate",
      "Birth Certificate issued by Municipal Authority",
      "Indian Passport (Valid)",
      "PAN Card"
    ],
    "address_proof": [
      "Aadhaar Card (with active linked mobile for e-KYC)",
      "Voter Identity Card (EPIC)",
      "Electricity / Water / Gas Utility Bill (last 2 months)",
      "Registered Rent Agreement / Indian Passport"
    ],
    "medical_fitness": [
      "Form 1: Self-Declaration of Physical Fitness (Mandatory for non-transport under 40)",
      "Form 1A: Medical Certificate signed by registered practitioner (For age 40+ or Transport class)"
    ]
  },
